# PetroPulse Frontend Environment Configuration
# Backend API Base URL
# - In local development, leave empty so requests route through Vite's reverse proxy (/api)
# - In production or separate domain deployment, set full URL (e.g., https://api.yourdomain.com)
VITE_API_URL=

# Backend proxy target used by Vite dev server
VITE_BACKEND_URL=http://127.0.0.1:5000

# Application Branding
VITE_APP_NAME=PetroPulse ERP
VITE_ENABLE_ANALYTICS=false
