{
  "name": "petropulse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:tsx": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && esbuild src/app.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "start": "tsx src/server.ts",
    "test": "tsx --test tests/health.test.mjs tests/codeGenAndValidation.test.mjs tests/api.test.mjs tests/logger.test.mjs tests/bunk.test.mjs tests/dbSync.test.mjs tests/mailHelper.test.mjs tests/pricing.test.mjs",
    "migrate": "drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:check": "tsx src/db/checkDb.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
