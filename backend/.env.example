# PetroPulse Backend Environment Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL / Supabase Transaction Mode Pooler)
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Database Connection for Migrations & DDL (Supabase Session Mode Pooler or Direct)
DIRECT_URL=postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Production CORS Allowed Origins (Comma-separated list or *)
CORS_ORIGIN=https://localhost:3000,https://localhost:5173,https://petropulse.app

# Authentication & Security Secrets
JWT_SECRET=super_secret_petropulse_jwt_signing_key_change_in_production
SESSION_EXPIRY_HOURS=24
BCRYPT_SALT_ROUNDS=10

# Forecourt Automated Scheduler
EOD_CLOSE_TIME=23:59:00
DEFAULT_TIMEZONE=Asia/Kolkata
